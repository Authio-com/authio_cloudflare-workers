{
  "name": "@useauthio/cloudflare-workers",
  "version": "0.2.0",
  "description": "Authio session verification for Cloudflare Workers, with JWKS caching in CF KV.",
  "license": "MIT",
  "author": "Authio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Authio-com/authio_cloudflare-workers.git"
  },
  "homepage": "https://authio.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^4.20260613.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "~4.1.11"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "undici": ">=8.12.2",
      "ws": ">=8.21.0",
      "nanoid": "^3.3.18",
      "source-map-js": ">=1.2.2",
      "vite": ">=7.3.7 <8",
      "zod": ">=4.6.6"
    }
  }
}
